---
import { LOCALES, type Locale } from "../lib/lang";
import { langName, langShort, useI18n } from "../i18n";
import { routeUrl, mapUrl, tel, site, type Route } from "../lib/site";

interface Props {
  locale: Locale;
  route: Route;
  current?: "home" | "menu";
}
const { locale, route, current } = Astro.props;
const { t } = useI18n(locale);
---

<div class="nav-wrap">
  <nav class="nav" aria-label={t("nav.primary")}>
    <a class="brand" href={routeUrl(locale)} lang="en">
      <span class="seal" aria-hidden="true">{locale === "zh-Hans" ? "鲜" : "鮮"}</span>
      {site.name}
    </a>

    <div class="nav-links">
      <a href={routeUrl(locale)} aria-current={current === "home" ? "page" : undefined}>{t("nav.home")}</a>
      <a href={routeUrl(locale, "menu")} aria-current={current === "menu" ? "page" : undefined}>{t("nav.menu")}</a>
      <a href={`${routeUrl(locale)}#visit`}>{t("nav.visit")}</a>
    </div>

    <div class="nav-tools">
      <details class="lang" data-lang-menu>
        <summary aria-label={`${langShort[locale]} · ${t("lang.label")}: ${langName[locale]}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.6 2.6 4 5.6 4 9s-1.4 6.4-4 9c-2.6-2.6-4-5.6-4-9s1.4-6.4 4-9Z"></path>
          </svg>
          <span>{langShort[locale]}</span>
        </summary>
        <ul>
          {
            LOCALES.map((l) => (
              <li>
                <a href={routeUrl(l, route)} lang={l} hreflang={l} data-set-lang={l} aria-current={l === locale ? "true" : undefined}>
                  {langName[l]}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <button
        type="button"
        class="icon-btn theme"
        data-theme-toggle
        aria-label={`${t("theme.label")}: ${t("theme.auto")}`}
        title={`${t("theme.label")}: ${t("theme.auto")}`}
      >
        <svg class="i i-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path>
        </svg>
        <svg class="i i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="i i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
        </svg>
      </button>

      <a class="btn btn-primary btn-sm nav-cta" href={`tel:${tel}`}>{t("nav.reserve")}</a>
    </div>
  </nav>
</div>

<nav class="dock" aria-label={t("nav.quick")}>
  <a href={routeUrl(locale, "menu")} aria-current={current === "menu" ? "page" : undefined}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"></path>
    </svg>
    {t("nav.menu")}
  </a>
  <a class="dock-primary" href={`tel:${tel}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"></path>
    </svg>
    {t("nav.call")}
  </a>
  <a href={mapUrl} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"></path><circle cx="12" cy="10" r="2.5"></circle>
    </svg>
    {t("nav.directions")}
  </a>
</nav>

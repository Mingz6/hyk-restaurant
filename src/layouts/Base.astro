---
import "@fontsource-variable/geist";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/global.css";
import serifUrl from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import sansUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import { LOCALES, detectLocale, type Locale } from "../lib/lang";
import { clientStrings, htmlLang, ogLocale, useI18n } from "../i18n";
import { assetUrl, routeUrl, siteBase, type Route } from "../lib/site";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  locale: Locale;
  route: Route;
  title: string;
  description: string;
  current?: "home" | "menu";
  /** The 404 page is served for any URL, so it must not redirect or advertise alternates. */
  notFound?: boolean;
}

const { locale, route, title, description, current, notFound = false } = Astro.props;
const { t } = useI18n(locale);
const abs = (path: string) => new URL(path, Astro.site).href;

// Runs before first paint. Only the English root pages redirect, and only when the visitor
// has not chosen a language yet (an explicit choice is stored by the language menu).
const langScript = `(function(){try{
var detect=${detectLocale.toString()};
var s=localStorage.getItem("hyk-lang");
var l=s==="en"||s==="zh-Hant"||s==="zh-Hans"?s:detect(navigator.languages&&navigator.languages.length?navigator.languages:[navigator.language||"en"]);
var p=l==="zh-Hant"?"zh-hant/":l==="zh-Hans"?"zh-hans/":"";
if(!p)return;
var base=${JSON.stringify(siteBase)};
location.replace(base+"/"+p+location.pathname.slice(base.length).replace(/^\\//,"")+location.search+location.hash);
}catch(e){}})();`;

const themeScript = `try{var t=localStorage.getItem("hyk-theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}`;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f0e5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={assetUrl("favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[locale]} />
    {
      !notFound && (
        <>
          <link rel="canonical" href={abs(routeUrl(locale, route))} />
          {LOCALES.map((l) => (
            <link rel="alternate" hreflang={l} href={abs(routeUrl(l, route))} />
          ))}
          <link rel="alternate" hreflang="x-default" href={abs(routeUrl("en", route))} />
        </>
      )
    }
    <script is:inline set:html={themeScript} />
    {locale === "en" && !notFound && <script is:inline set:html={langScript} />}
  </head>
  <body>
    <a class="skip" href="#main">{t("skip")}</a>
    <div class="strip">
      <strong>{t("strip.label")}</strong> {t("strip.text")}
    </div>
    <Nav locale={locale} route={notFound ? "" : route} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline id="i18n" type="application/json" set:html={JSON.stringify(clientStrings(locale))} />
    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>
